# Copiez ce fichier en ".env" et remplissez les valeurs avant de démarrer le serveur.
# NE JAMAIS mettre ce fichier .env dans un ZIP livré à un client, ni dans un dépôt public.

# Clé secrète utilisée pour calculer/vérifier les clés de licence (HMAC-SHA256).
# IMPORTANT (correction audit V-001/V-002) : cette clé doit être NOUVELLE et DIFFÉRENTE de
# l'ancienne clé "TRPK-ABD-CONSULTING-2026-..." qui était auparavant intégrée (cachée) dans le
# logiciel client. Cette nouvelle clé ne doit JAMAIS exister ailleurs que sur ce serveur.
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_LICENCE=CHANGEZ-MOI-GENEREZ-UNE-NOUVELLE-CLE-ALEATOIRE

# Mot de passe administrateur pour créer/révoquer des licences via l'API /api/admin/*.
# Choisissez un mot de passe fort, différent de vos autres mots de passe.
ADMIN_PASSWORD=CHANGEZ-MOI-AVANT-DEPLOIEMENT

# Port d'écoute du serveur (la plupart des hébergeurs cloud imposent process.env.PORT automatiquement).
PORT=3500
